{
  "manifest_version": 3,
  "name": "Video Curtain",
  "description": "Fullscreen video without a new desktop: the video fills the Safari window and a black curtain covers everything else.",
  "version": "1.3",
  "icons": { "128": "icon-128.png" },
  "permissions": ["nativeMessaging", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "css": ["page.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    { "resources": ["page.js"], "matches": ["<all_urls>"] }
  ]
}
